{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://cyanide-is-unblockable.vercel.app;"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self \"https://cyanide-is-unblockable.vercel.app\"), microphone=(self \"https://cyanide-is-unblockable.vercel.app\"), camera=(self \"https://cyanide-is-unblockable.vercel.app\"), payment=(self \"https://cyanide-is-unblockable.vercel.app\")"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://cyanide-is-unblockable.vercel.app"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        }
      ]
    }
  ]
}
